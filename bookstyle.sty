% \code{...}: inline code in a monospaced font, coloured Primary3. No background box,
% so it sits lightly in prose.
\newcommand{\code}[1]{\texttt{\textcolor{Primary3}{#1}}}

\newcommand{\todo}[1]{{\textcolor{orange}{\texttt{TODO: #1}}}}

\newtcolorbox{quotebox}[2][]{breakable,sharp corners, skin=enhancedmiddle jigsaw,parbox=false,
